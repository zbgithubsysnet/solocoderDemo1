{
  "name": "realtime-chat",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "start": "npm run start:server",
    "start:server": "npm --workspace server start",
    "start:client": "npm --workspace client dev",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm --workspace server build",
    "build:client": "npm --workspace client build",
    "test:e2e": "npm --workspace e2e test",
    "test:e2e:ui": "npm --workspace e2e test:ui"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
